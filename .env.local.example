# FTP credentials for Hostinger deployment
# Copy this file to .env.local and fill in your values.
#
# Get FTP_HOST from: Hostinger hPanel → Hosting → Files → FTP Accounts → Details
# IMPORTANT: use the server address shown there (e.g. srv12345.hstgr.com or an IP)
#            NOT the website subdomain - that resolves to a CDN, not the FTP server.

FTP_HOST=srv12345.hstgr.com
FTP_USER=u457360812.yourftpuser
FTP_PASSWORD=your_ftp_password

# Optional
# FTP_PASS=            # alias for FTP_PASSWORD (both work)
# FTP_PORT=21          # default 21
# FTP_SECURE=true      # enable explicit FTPS/AUTH TLS - try if plain FTP times out
# SOURCE_DIR=out       # default 'out'
# PROTECTED_ITEMS=     # comma-separated items to never delete on the server
